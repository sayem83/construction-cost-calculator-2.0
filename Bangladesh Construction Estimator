// MAIN CALCULATION
// ----------------------------------------------------------------
function calc() {
  const sqft   = Math.max(0, +(g('area')?.value || 0));
  const floors = Math.max(1, +(g('floors')?.value || 1));
  const bsmt   = Math.max(0, +(g('basement')?.value || 0));
  const brate  = Math.max(0, +(g('brate')?.value || 2200));
  const lifts  = Math.max(0, +(g('lifts')?.value || 0));
  const bF     = getBF();
  const mF     = getMF();
  const qual   = Math.max(0, +(g('quality')?.value || 1.0));
  const strct  = Math.max(0, +(g('struct')?.value || 1.0));
  const found  = Math.max(0, +(g('found')?.value || 0.10));
  const conc   = Math.max(1, +(g('conc')?.value || 1.08));
  const areaT  = Math.max(0, +(g('area-type')?.value || 1.0));
  const seis   = Math.max(1, +(g('seismic')?.value || 1.05));
  const flood  = Math.max(1, +(g('flood')?.value || 1.08));
  const spEnv  = Math.max(1, +(g('sp-env')?.value || 1.0));
  const vat    = Math.max(0, +(g('vat')?.value || 15));
  const cong   = Math.max(0, +(g('cong')?.value || 5));
  const marg   = Math.max(0, +(g('marg')?.value || 10));
  const infl   = Math.max(0, +(g('infl')?.value || 3));
  const dfee   = Math.max(0, +(g('dfee')?.value || 2));
  const sfee   = Math.max(0, +(g('sfee')?.value || 1));
  const landP  = Math.max(0, +(g('land-price')?.value || 0));
  const gasDist= Math.max(0, +(g('gas-dist')?.value || 0));

  // ---- ENV FACTOR ----
  const envF = areaT * seis * flood * spEnv;
  s('ef1', areaT.toFixed(2)); s('ef2', seis.toFixed(2));
  s('ef3', flood.toFixed(2)); s('ef4', spEnv.toFixed(2));
  s('ef-tot', envF.toFixed(3));

  // ---- CONFIG FACTOR ----
  // configF = bF × qual × struct × concrete × env × (1 + foundation)
  const configF = bF * qual * strct * conc * envF * (1 + found);
  s('bf-d',  bF.toFixed(2));
  s('qs-d',  (qual * strct).toFixed(2));
  s('env-d', envF.toFixed(3));
  s('cf-d',  configF.toFixed(3));

  // ---- BASE COST (Physics: force × area = stress → analogously cost/sqft × area × factor) ----
  // Basement floors cost 40% more per sqft
  const baseSqft   = sqft * (floors / (floors + bsmt));
  const bsmtSqft   = sqft * (bsmt / (floors + bsmt));
  const baseCost   = baseSqft * brate * configF + bsmtSqft * brate * configF * 1.40;
  s('bc-d', fmt(baseCost));

  // ---- MATERIALS ----
  const mats = calcMats(sqft, mF);
  const matTotal = mats.reduce((t, m) => t + m.total, 0);
  // Render material table
  const tb = g('mat-body');
  if (tb) {
    const catTotals = {};
    mats.forEach(m => { catTotals[m.cat] = (catTotals[m.cat] || 0) + m.total; });
    tb.innerHTML = mats.map(m => `<tr>
      <td style="padding-left:18px;font-weight:500">${m.nm}</td>
      <td><span style="background:var(--g100);color:var(--g800);font-size:10px;padding:2px 6px;border-radius:10px;font-weight:600">${m.cat}</span></td>
      <td class="mq">${m.qty.toLocaleString()}</td>
      <td>${m.u}</td>
      <td>৳ ${m.r.toLocaleString()}</td>
      <td class="ma" style="padding-right:18px">৳ ${m.total.toLocaleString()}</td>
    </tr>`).join('') + `<tr class="mt-tot">
      <td colspan="5" style="padding-left:18px;font-size:13px">মোট ম্যাটেরিয়াল খরচ</td>
      <td class="ma" style="padding-right:18px;font-size:14px;color:var(--g700)">৳ ${matTotal.toLocaleString()}</td>
    </tr>`;
    updateMatCharts(mats, catTotals);
  }

  // ---- LABOR (REAL LOGIC) ----
  // Total MD per trade = mdPerSqft × sqft × bF (building type factor) × structureFactor
  const laborRes = renderLabor();
  let laborMD = 0, laborCost = 0;
  LABOR.forEach(l => {
    const md = Math.round(l.mdPerSqft * sqft * bF * strct);
    laborMD += md;
    const wd = l.count > 0 ? Math.ceil(md / l.count) : md;
    laborCost += l.count * l.wage * wd;
  });
  // Equipment
  const crane  = Math.max(0, +(g('crane')?.value || 0)) * 3500;
  const mixer  = Math.max(0, +(g('mixer')?.value || 0)) * 1800;
  const cpump  = Math.max(0, +(g('cpump')?.value || 0)) * 8000;
  const vibr   = Math.max(0, +(g('vibr')?.value || 0)) * 500;
  const scaff  = Math.max(0, +(g('scaff')?.value || 0)) * 2000;
  const dewat  = Math.max(0, +(g('dewat')?.value || 0)) * 1500;
  const bull   = Math.max(0, +(g('bull')?.value || 0)) * 25000;
  const excav  = Math.max(0, +(g('excav')?.value || 0)) * 20000;
  const cutter = Math.max(0, +(g('cutter')?.value || 0)) * 3000;
  const equipCost = crane + mixer + cpump + vibr + scaff + dewat + bull + excav + cutter;
  const totalLabor = laborCost + equipCost;
  s('equip-tot', '৳ ' + Math.round(equipCost).toLocaleString());

  // ---- TIMELINE (Physics-based: Work = Power × Time → Time = Work / Power) ----
  // Total daily labor power (workers)
  const totalDailyWorkers = LABOR.reduce((t, l) => t + l.count, 0);
  // Work days = total man-days / daily workers
  const workDays = totalDailyWorkers > 0 ? Math.ceil(laborMD / totalDailyWorkers) : laborMD;
  const months   = Math.max(1, Math.ceil(workDays / 25)); // 25 working days/month
  const pct      = Math.min(100, (months / 36) * 100);

  // Update KPIs and Timeline
  s('ic-md', laborMD.toLocaleString());
  s('ic-time', months + ' মাস');
  s('ic-lcost', fmt(totalLabor));
  s('tl-total', months + ' মাস');
  s('tl-workers', totalDailyWorkers + ' জন');
  s('kpi-md', 'ম্যান-ডে: ' + laborMD.toLocaleString());
  s('kpi-workers', totalDailyWorkers);
  s('kpi-workdays', 'কার্যদিবস: ' + workDays);

  // Efficiency score
  const effScore = sqft > 0 ? (laborMD / sqft).toFixed(3) : '—';
  s('ic-eff', effScore + ' md/sqft');

  // Change indicators
  const mdChg = laborMD > prevMD ? 'ch-up' : laborMD < prevMD ? 'ch-dn' : 'ch-ne';
  const mdChgTxt = laborMD > prevMD ? '↑ ম্যান-ডে বেড়েছে' : laborMD < prevMD ? '↓ ম্যান-ডে কমেছে' : '—';
  const lcChg = totalLabor > prevLC ? 'ch-up' : totalLabor < prevLC ? 'ch-dn' : 'ch-ne';
  const lcTxt = totalLabor > prevLC ? '↑ খরচ বেড়েছে' : totalLabor < prevLC ? '↓ খরচ কমেছে' : '—';
  const mdEl = g('ic-md-chg'); if (mdEl) { mdEl.className = 'ic-chg ' + mdChg; mdEl.textContent = mdChgTxt; }
  const lcEl = g('ic-lc-chg'); if (lcEl) { lcEl.className = 'ic-chg ' + lcChg; lcEl.textContent = lcTxt; }
  prevMD = laborMD; prevLC = totalLabor;

  // Timeline milestones
  const tff = g('tl-fill'); if (tff) tff.style.width = pct + '%';
  s('m1', Math.ceil(months * 0.18) + ' মাস'); s('m2', Math.ceil(months * 0.40) + ' মাস');
  s('m3', Math.ceil(months * 0.65) + ' মাস'); s('m4', Math.ceil(months * 0.85) + ' মাস');
  s('m5', months + ' মাস');
  // Timeline tip
  let tip = '';
  if (totalDailyWorkers > 20) tip = '⚡ শ্রমিক বেশি — নির্মাণ দ্রুত, তবে সমন্বয় গুরুত্বপূর্ণ।';
  else if (totalDailyWorkers < 8) tip = '⚠️ শ্রমিক কম — সময় বেশি লাগবে। আরও শ্রমিক যোগ করুন অথবা "2× লেবার" বাটন ব্যবহার করুন।';
  else tip = `✅ ${totalDailyWorkers} জন শ্রমিকে ${workDays} কার্যদিবস = ${months} মাস নির্মাণকাল।`;
  s('tl-tip', tip);

  // ---- FLOOR COSTS ----
  const sqftPerFloor = sqft / (floors + bsmt);
  let floorCostTotal = 0;
  FLOORS_DATA.forEach((fd, i) => {
    const finExtra = FLOOR_FINISHES.find(f => f.v === fd.finish)?.extra || 0;
    const tileExtra = getTileCost(fd.tile);
    const ceilExtra = getCeilCost(fd.ceil);
    const acExtra = fd.ac ? 70000 : 0;
    const marbleExtra = fd.marble ? sqftPerFloor * 200 : 0;
    const bsmtMult = fd.isBasement ? 1.40 : 1.0;
    const floorBase = sqftPerFloor * brate * configF * bsmtMult;
    const floorFinish = sqftPerFloor * (finExtra + tileExtra + ceilExtra) * bsmtMult;
    const fc = floorBase + floorFinish + acExtra + marbleExtra + fd.extra;
    floorCostTotal += fc;
    const fcEl = g(`floor-cost-${i}`);
    const fcBoxEl = g(`floor-cost-box-${i}`);
    if (fcEl) fcEl.textContent = fmt(fc);
    if (fcBoxEl) fcBoxEl.textContent = 'এই তলা: ' + fmt(fc);
  });
  // Use floorCostTotal if > baseCost (custom design was applied)
  const effectiveBase = floorCostTotal > 0 && FLOORS_DATA.length === floors + bsmt
    ? floorCostTotal
    : baseCost;

  // ---- EXTRAS ----
  const extrasTotal = getExtrasCost();
  s('extras-tot-d', fmt(extrasTotal));

  // ---- SPECIAL FEATURES ----
  const specTotal = getSFTotal();
  s('spec-tot', fmt(specTotal));

  // ---- LIFT COST ----
  const liftCost = lifts * 2500000;

  // ---- PROFESSIONAL FEES ----
  const profFees = effectiveBase * (dfee + sfee) / 100;

  // ---- GOVT FEES (BNBC / RAJUK real rates) ----
  const rajukFee = sqft * floors * 16 + (floors > 5 ? (floors - 5) * sqft * 6 : 0);
  const wasaFee  = 30000;
  const elecFee  = sqft > 5000 ? 200000 : 70000;
  const gasFee   = 40000 + gasDist * 800;
  const regFee   = landP * 0.07;
  const stampFee = landP * 0.015;
  const ecoFee   = ['hosp','h3','h5','res_rt','fact','garm','food','pharma'].includes(g('btype')?.value || '') ? 120000 : 0;
  const tdsFee   = effectiveBase * 0.07;
  const govtTotal = rajukFee + wasaFee + elecFee + gasFee + regFee + stampFee + ecoFee + tdsFee + 5000;

  // Update fee display
  s('ff-rajuk', '৳ ' + Math.round(rajukFee).toLocaleString());
  s('ff-wasa',  '৳ ' + Math.round(wasaFee).toLocaleString());
  s('ff-elec',  '৳ ' + Math.round(elecFee).toLocaleString());
  s('ff-gas',   '৳ ' + Math.round(gasFee).toLocaleString());
  s('ff-reg',   '৳ ' + Math.round(regFee).toLocaleString());
  s('ff-stamp', '৳ ' + Math.round(stampFee).toLocaleString());
  s('ff-eco',   '৳ ' + Math.round(ecoFee).toLocaleString());
  s('ff-tds',   '৳ ' + Math.round(tdsFee).toLocaleString());
  s('ff-tot',   '৳ ' + Math.round(govtTotal).toLocaleString());

  // ---- SUBTOTAL & CHARGES ----
  const sub    = effectiveBase + totalLabor + extrasTotal + specTotal + liftCost + profFees;
  const vatA   = sub * vat  / 100;
  const congA  = sub * cong / 100;
  const margA  = sub * marg / 100;
  const inflA  = sub * infl / 100;
  const charges = vatA + congA + margA + inflA;
  const grand  = sub + charges + govtTotal;
  const perSqft = sqft > 0 ? grand / sqft : 0;

  // ---- UPDATE ALL KPIs ----
  s('kpi-total', fmt(grand));
  s('kpi-sqft',  'প্রতি sqft: ' + fmt(perSqft));
  s('kpi-time',  months + ' মাস');
  s('kpi-govt',  fmt(govtTotal + charges));
  s('kpi-env',   envF.toFixed(2));
  const szEl = g('seismic'); s('kpi-zone', 'জোন: ' + (szEl ? szEl.options[szEl.selectedIndex]?.text.split(' ')[0] : '—'));

  // ---- BREAKDOWN ----
  s('br-base',  fmt(effectiveBase));
  s('br-labor', fmt(totalLabor));
  s('br-extras',fmt(extrasTotal));
  s('br-spec',  fmt(specTotal));
  s('br-prof',  fmt(profFees));
  s('br-vat',   fmt(charges));
  s('br-govt',  fmt(govtTotal));
  s('br-tot',   fmt(grand));

  // ---- REPORT ----
  const rMeta = g('rpt-meta');
  if (rMeta) rMeta.textContent = 'তারিখ: ' + new Date().toLocaleDateString('bn-BD') + ' | জেলা: ' + (g('sel-dist')?.value || '—') + ' | বিল্ডিং: ' + (g('btype')?.options[g('btype')?.selectedIndex]?.text.split(' ×')[0] || '—');
  const rp = g('rpt-pills');
  if (rp) rp.innerHTML = [
    '📐 ' + sqft.toLocaleString() + ' sqft',
    '🏢 ' + floors + ' তলা',
    '⏱️ ' + months + ' মাস',
    '👷 ' + totalDailyWorkers + ' জন/দিন',
    '💰 ' + fmt(grand),
    '📍 ' + (g('sel-dist')?.value || '—'),
  ].map(p => `<div class="r-pill">${p}</div>`).join('');

  const rd = g('rpt-detail');
  if (rd) rd.innerHTML = [
    ['মূল নির্মাণ (' + sqft.toLocaleString() + ' sqft × ৳' + brate + ' × ' + configF.toFixed(2) + ')', effectiveBase],
    ['শ্রমিক মজুরি', laborCost],
    ['যন্ত্রপাতি ভাড়া', equipCost],
    ['লিফট (' + lifts + 'টি)', liftCost],
    ['অতিরিক্ত সুবিধা', extrasTotal],
    ['স্পেশাল ফিচারস', specTotal],
    ['পেশাদার ফি (আর্কি+ইঞ্জি ' + (dfee+sfee) + '%)', profFees],
    ['ভ্যাট ' + vat + '%', vatA],
    ['কন্টিনজেন্সি ' + cong + '%', congA],
    ['কন্ট্রাক্টর মার্জিন ' + marg + '%', margA],
    ['মুদ্রাস্ফীতি ' + infl + '%', inflA],
    ['সরকারি ও আইনি ফি', govtTotal],
  ].map(([l, v]) => `<div class="br-row"><span class="br-lbl">${l}</span><span class="br-val">${fmt(v)}</span></div>`).join('') +
  `<div class="br-row br-tot"><span class="br-lbl">সর্বমোট নির্মাণ ব্যয়</span><span class="br-val">${fmt(grand)}</span></div>
   <div style="margin-top:7px;font-size:12px;color:var(--textm)">প্রতি বর্গফুট: <strong style="color:var(--g700)">${fmt(perSqft)}</strong></div>`;

  // ---- CHARTS ----
  updateMainCharts({
    base: effectiveBase, labor: totalLabor, extras: extrasTotal,
    spec: specTotal, vat: charges, govt: govtTotal,
  }, sqft, floors, effectiveBase, months, grand);

  // ---- LOAN ----
  calcLoan();
}

// ----------------------------------------------------------------
// CHARTS
// ----------------------------------------------------------------
const COLORS = ['#166534','#d97706','#0284c7','#dc2626','#7c3aed','#0d9488','#db2777','#ea580c','#65a30d','#0891b2'];

function mkChart(id, type, data, opts) {
  if (CHARTS[id]) { CHARTS[id].destroy(); }
  const cv = g(id);
  if (!cv) return;
  CHARTS[id] = new Chart(cv, { type, data, options: { responsive: true, maintainAspectRatio: false, ...opts } });
  return CHARTS[id];
}

function updateMatCharts(mats, catTotals) {
  // Bar chart by item
  mkChart('matChart', 'bar', {
    labels: mats.slice(0, 20).map(m => m.nm.substring(0, 14) + (m.nm.length > 14 ? '…' : '')),
    datasets: [{ label: 'খরচ (৳)', data: mats.slice(0, 20).map(m => m.total), backgroundColor: mats.slice(0, 20).map((_, i) => COLORS[i % COLORS.length]), borderRadius: 4 }]
  }, { plugins: { legend: { display: false } }, scales: { y: { ticks: { callback: v => '৳' + Math.round(v / 1000) + 'হা' } }, x: { ticks: { autoSkip: false, maxRotation: 40, font: { size: 9 } } } } });

  // Pie by category
  const cats = Object.keys(catTotals);
  mkChart('matPieChart', 'doughnut', {
    labels: cats,
    datasets: [{ data: cats.map(c => catTotals[c]), backgroundColor: COLORS, borderWidth: 2, borderColor: '#fff' }]
  }, { plugins: { legend: { position: 'bottom', labels: { font: { size: 10 }, boxWidth: 10 } } }, cutout: '60%' });
}

function updateMainCharts(bd, sqft, floors, baseCost, months, grand) {
  // DONUT
  mkChart('donutChart', 'doughnut', {
    labels: ['মূল নির্মাণ', 'শ্রমিক ও যন্ত্র', 'অতিরিক্ত', 'স্পেশাল', 'ভ্যাট ও চার্জ', 'সরকারি ফি'],
    datasets: [{ data: [bd.base, bd.labor, bd.extras, bd.spec, bd.vat, bd.govt], backgroundColor: COLORS, borderWidth: 2, borderColor: '#fff', hoverOffset: 4 }]
  }, {
    cutout: '62%',
    plugins: {
      legend: { display: false },
      tooltip: { callbacks: { label: ctx => ' ' + fmt(ctx.parsed) + ' (' + (grand > 0 ? Math.round(ctx.parsed / grand * 100) : 0) + '%)' } }
    }
  });
  // Donut legend
  const lg = g('donut-leg');
  if (lg) {
    const labs = ['মূল নির্মাণ', 'শ্রমিক ও যন্ত্র', 'অতিরিক্ত', 'স্পেশাল', 'ভ্যাট ও চার্জ', 'সরকারি ফি'];
    const vals = [bd.base, bd.labor, bd.extras, bd.spec, bd.vat, bd.govt];
    lg.innerHTML = labs.map((l, i) => `<div class="leg-item"><div class="leg-dot" style="background:${COLORS[i]}"></div><span class="leg-nm">${l}</span><span class="leg-pct"> ${grand > 0 ? Math.round(vals[i] / grand * 100) : 0}%</span></div>`).join('');
  }

  // FLOOR CHART
  const fCount = Math.min(floors, 12);
  const perFloor = baseCost / Math.max(1, floors);
  const flabels = [], fdata = [], fcolors = [];
  for (let i = 1; i <= fCount; i++) {
    flabels.push(i + 'তলা');
    // Real physics: upper floors have slightly less structural cost
    const mult = i === 1 ? 1.18 : i <= 3 ? 1.05 : i <= 7 ? 1.0 : 0.95;
    fdata.push(Math.round(perFloor * mult));
    fcolors.push(i === 1 ? COLORS[0] : COLORS[2]);
  }
  mkChart('floorChart', 'bar', {
    labels: flabels,
    datasets: [{ label: 'খরচ', data: fdata, backgroundColor: fcolors, borderRadius: 5, borderSkipped: false }]
  }, {
    plugins: { legend: { display: false } },
    scales: { y: { ticks: { callback: v => '৳' + Math.round(v / 100000) + 'লা' } }, x: { ticks: { autoSkip: false, maxRotation: 30, font: { size: 10 } } } }
  });

  // CASHFLOW CHART (monthly S-curve)
  const cashLabels = [], cashData = [];
  for (let m = 1; m <= Math.min(months, 24); m++) {
    cashLabels.push(m + 'মাস');
    // S-curve: slow start, fast middle, slow end
    const pct = m / months;
    const sCurve = pct < 0.2 ? pct * pct * 2.5 : pct < 0.8 ? 0.1 + (pct - 0.2) * 1.5 : 0.1 + 0.9 + (pct - 0.8) * 0.5;
    cashData.push(Math.round(grand * Math.min(1, sCurve) / months));
  }
  mkChart('cashflowChart', 'line', {
    labels: cashLabels,
    datasets: [{ label: 'মাসিক ব্যয়', data: cashData, fill: true, borderColor: COLORS[0], backgroundColor: 'rgba(22,163,74,0.1)', tension: 0.4, pointRadius: 2 }]
  }, {
    plugins: { legend: { display: false } },
    scales: { y: { ticks: { callback: v => '৳' + Math.round(v / 100000) + 'লা' } }, x: { ticks: { maxTicksLimit: 12, font: { size: 10 } } } }
  });

  // COMPARE CHART (vs market average)
  const perSqft = sqft > 0 ? grand / sqft : 0;
  mkChart('compareChart', 'bar', {
    labels: ['আপনার প্রজেক্ট', 'ঢাকা মেট্রো গড়', 'বিভাগীয় শহর গড়', 'উপজেলা গড়'],
    datasets: [{
      label: 'প্রতি sqft খরচ (৳)',
      data: [Math.round(perSqft), 4800, 3200, 2100],
      backgroundColor: [COLORS[0], COLORS[1], COLORS[2], COLORS[3]],
      borderRadius: 6,
    }]
  }, {
    plugins: { legend: { display: false } },
    scales: { y: { ticks: { callback: v => '৳' + v.toLocaleString() } } }
  });

  // LABOR CHART
  mkChart('laborChart', 'bar', {
    labels: LABOR.map(l => l.name.substring(0, 8)),
    datasets: [
      { label: 'ম্যান-ডে', data: LABOR.map(l => Math.round(l.mdPerSqft * sqft * getBF())), backgroundColor: COLORS[0], borderRadius: 4 },
      { label: 'সংখ্যা ×১০', data: LABOR.map(l => l.count * 10), backgroundColor: COLORS[1], borderRadius: 4 },
    ]
  }, {
    plugins: { legend: { position: 'top', labels: { font: { size: 10 } } } },
    scales: { y: { ticks: { font: { size: 10 } } }, x: { ticks: { font: { size: 9 }, maxRotation: 35 } } }
  });

  // PROGRESS CHART (S-curve cumulative)
  const stages = ['ভিত্তি','কলাম/স্ল্যাব','দেয়াল','MEP','প্লাস্টার','ফিনিশিং'];
  const stagePct = [10, 25, 40, 60, 80, 100];
  mkChart('progressChart', 'radar', {
    labels: stages,
    datasets: [{
      label: 'নির্মাণ অগ্রগতি (%)',
      data: stagePct,
      borderColor: COLORS[0],
      backgroundColor: 'rgba(22,163,74,0.15)',
      pointBackgroundColor: COLORS[0],
    }]
  }, {
    scales: { r: { min: 0, max: 100, ticks: { stepSize: 20, font: { size: 9 } }, pointLabels: { font: { size: 10 } } } },
    plugins: { legend: { display: false } }
  });
}

