// --- LABOR RENDERING ---
function renderLabor() {
  const sqft = Math.max(100, +(g('area')?.value || 2000));
  const bF = getBF();
  const structF = +(g('struct')?.value || 1.0);
  const tb = g('labor-body');
  if (!tb) return;
  tb.innerHTML = '';
  let grandMD = 0, grandCost = 0;
  LABOR.forEach((l, i) => {
    // REAL LOGIC: totalMD = mdPerSqft × sqft × buildingFactor × structureFactor
    const totalMD = Math.round(l.mdPerSqft * sqft * bF * structF);
    const workDays = l.count > 0 ? Math.ceil(totalMD / l.count) : totalMD;
    const cost = l.count * l.wage * workDays;
    grandMD += totalMD;
    grandCost += cost;
    tb.innerHTML += `<tr>
      <td style="padding-left:18px">
        <input type="text" value="${l.name}" style="width:160px;font-size:12px;padding:4px 7px;border:1px solid var(--border);border-radius:var(--r4);font-family:inherit;background:transparent;color:var(--text)" onchange="LABOR[${i}].name=this.value">
        <span class="role-tag ${ROLE_TAG[l.role]||'rt-hel'}" style="margin-left:4px;font-size:9.5px">${ROLE_LBL[l.role]||''}</span>
      </td>
      <td><input type="number" value="${l.count}" min="1" style="width:52px;padding:4px 6px;border:1px solid var(--border);border-radius:var(--r4);font-family:inherit;font-size:12px" onchange="LABOR[${i}].count=Math.max(1,+this.value);renderLabor();calc()"></td>
      <td><input type="number" value="${l.wage}" min="0" style="width:85px;padding:4px 6px;border:1px solid var(--border);border-radius:var(--r4);font-family:inherit;font-size:12px" onchange="LABOR[${i}].wage=Math.max(0,+this.value);renderLabor();calc()"></td>
      <td style="color:var(--textm);font-size:12px;text-align:center">${workDays}</td>
      <td style="color:var(--textm);font-size:11px;text-align:center">${l.mdPerSqft}</td>
      <td style="font-weight:700;color:var(--g700);text-align:center;font-size:12px">${totalMD.toLocaleString()}</td>
      <td style="color:var(--b600);font-weight:700;text-align:center;font-size:12px">${workDays} <small style="color:var(--textf)">দিন</small></td>
      <td class="labor-cost-cell" style="padding-right:14px">৳ ${Math.round(cost).toLocaleString()}</td>
      <td style="padding-right:10px"><button class="del-btn" onclick="LABOR.splice(${i},1);renderLabor();calc()" title="মুছুন">✕</button></td>
    </tr>`;
  });
  s('labor-grand', '৳ ' + Math.round(grandCost).toLocaleString());
  return { grandMD, grandCost };
}

function addLabor() {
  LABOR.push({ name: 'নতুন শ্রমিক', role: 'hel', count: 1, wage: 700, mdPerSqft: 0.01 });
  renderLabor(); calc();
}
function resetLabor() { LABOR = JSON.parse(JSON.stringify(DEFAULT_LABOR)); renderLabor(); calc(); }

// Quick Scale Buttons — REAL LOGIC
function scaleLabor(factor) {
  LABOR.forEach(l => l.count = Math.max(1, Math.round(l.count * factor)));
  renderLabor(); calc();
}

