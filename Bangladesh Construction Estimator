  if (wrap) wrap.classList.toggle('sel', chk?.checked);
  updSFCount(); calc();
}

function updSFCount() {
  let c = 0;
  document.querySelectorAll('.feat-chk').forEach(ch => { if (ch.checked) c++; });
  s('spec-sel-cnt', c);
}

function clearFeats() {
  document.querySelectorAll('.feat-chk').forEach(ch => ch.checked = false);
  document.querySelectorAll('.feat-item').forEach(w => w.classList.remove('sel'));
  updSFCount(); calc();
}

function selectCommon() {
  [0, 1, 2, 5].forEach(i => {
    const chk = g(`sf-chk-${i}`);
    const wrap = g(`sf-wrap-${i}`);
    if (chk) { chk.checked = true; wrap?.classList.add('sel'); }
  });
  updSFCount(); calc();
}

function getSFTotal() {
  const val = g('btype')?.value || 'res_s';
  const key = getSFKey(val);
  const feats = SF[key] || SF['_def'];
  let t = 0;
  feats.forEach((f, i) => {
    const chk = g(`sf-chk-${i}`);
    if (chk?.checked) {
      const qEl = g(`sf-qty-${i}`);
      const q = qEl ? Math.max(1, +qEl.value) : 1;
      t += f.c * q;
    }
  });
  return t;
}

