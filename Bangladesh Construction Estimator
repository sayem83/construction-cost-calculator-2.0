          </select>
        </div>
        <div class="fg" style="margin-bottom:8px"><label>সিলিং ধরণ</label>
          <select onchange="FLOORS_DATA[${i}].ceil=this.value;calc()" style="font-size:12px;padding:6px 8px">
            ${FLOOR_CEIL.map(c => `<option value="${c.v}" ${fd.ceil===c.v?'selected':''}>${c.l}</option>`).join('')}
