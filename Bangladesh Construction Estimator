<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>নির্মাণ হিসাব Pro — Bangladesh Construction Estimator</title>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
:root{
  --g900:#0a3d1f;--g800:#0f5429;--g700:#166534;--g600:#16a34a;--g500:#22c55e;--g400:#4ade80;--g100:#dcfce7;--g50:#f0fdf4;
  --a600:#d97706;--a500:#f59e0b;--a400:#fbbf24;--a100:#fef3c7;
  --b600:#0284c7;--b500:#0ea5e9;--b100:#e0f2fe;
  --r600:#dc2626;--r100:#fee2e2;
  --p600:#7c3aed;--p100:#ede9fe;
  --t600:#0d9488;--t100:#ccfbf1;
  --n50:#f8faf8;--n100:#e8f3e9;--n200:#cde0ce;--n300:#a8c5aa;--n400:#7a9e7c;--n500:#5a7a5c;--n600:#3f5440;--n700:#2d3b2c;
  --white:#fff;--surface:#f2f7f2;--card:#fff;--border:#d4e4d5;
  --text:#0d1f0e;--text2:#3d5c3e;--textm:#6b8f6d;--textf:#9ab89c;
  --sh1:0 1px 3px rgba(0,0,0,.06);--sh2:0 4px 12px rgba(0,0,0,.08);--sh3:0 10px 30px rgba(0,0,0,.1);
  --r4:4px;--r8:8px;--r12:12px;--r16:16px;--r20:20px;
  --sw:272px;--hh:60px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Hind Siliguri',sans-serif;background:var(--surface);color:var(--text);min-height:100vh;-webkit-font-smoothing:antialiased}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:var(--n100)}
::-webkit-scrollbar-thumb{background:var(--n300);border-radius:10px}

/* LAYOUT */
.app{display:flex;min-height:100vh}

/* SIDEBAR */
.sidebar{
  width:var(--sw);background:linear-gradient(180deg,#052212 0%,#0a3d1f 60%,#061a0e 100%);
  display:flex;flex-direction:column;position:fixed;top:0;left:0;height:100vh;overflow-y:auto;
  z-index:300;transition:transform .3s cubic-bezier(.4,0,.2,1);box-shadow:4px 0 20px rgba(0,0,0,.3)
}
.sidebar.hidden{transform:translateX(calc(-1 * var(--sw)))}
.sb-logo{padding:22px 20px 16px;border-bottom:1px solid rgba(255,255,255,.08)}
.sb-logo-row{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.sb-icon{width:38px;height:38px;background:linear-gradient(135deg,var(--g600),var(--g400));border-radius:var(--r8);display:flex;align-items:center;justify-content:center;font-size:19px;box-shadow:0 4px 12px rgba(34,197,94,.4);flex-shrink:0}
.sb-title{font-size:16px;font-weight:700;color:#fff;line-height:1.2}
.sb-sub{font-size:9px;color:rgba(255,255,255,.35);letter-spacing:.1em;text-transform:uppercase;margin-top:2px}
.sb-ver{display:inline-block;background:var(--a500);color:#000;font-size:9px;font-weight:700;padding:2px 7px;border-radius:10px}
.sb-section{padding:4px 0}
.sb-label{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:rgba(255,255,255,.22);padding:10px 20px 3px}
.nav-item{display:flex;align-items:center;gap:9px;padding:9px 20px;cursor:pointer;color:rgba(255,255,255,.5);font-size:13px;border-left:3px solid transparent;transition:all .2s}
.nav-item:hover{color:rgba(255,255,255,.9);background:rgba(255,255,255,.05)}
.nav-item.active{color:#fff;background:rgba(34,197,94,.12);border-left-color:var(--g400);font-weight:600}
.nav-item.active .ni{color:var(--g400)}
.ni{font-size:16px;width:18px;text-align:center;flex-shrink:0}
.nb{margin-left:auto;background:var(--a500);color:#000;font-size:9px;font-weight:700;padding:2px 6px;border-radius:10px;flex-shrink:0}
.sb-footer{margin-top:auto;padding:14px 20px;border-top:1px solid rgba(255,255,255,.06);font-size:10px;color:rgba(255,255,255,.28);line-height:1.7}
.bnbc-chip{display:inline-flex;align-items:center;gap:3px;background:rgba(34,197,94,.15);color:var(--g400);font-size:9px;font-weight:700;padding:2px 7px;border-radius:10px;margin-bottom:5px}

/* MAIN */
.main{margin-left:var(--sw);flex:1;display:flex;flex-direction:column;min-height:100vh;transition:margin-left .3s}

/* TOPBAR */
.topbar{height:var(--hh);background:var(--card);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 24px;position:sticky;top:0;z-index:200;box-shadow:var(--sh1);gap:10px;flex-wrap:wrap}
.tb-left{display:flex;align-items:center;gap:10px;min-width:0}
.hburg{display:none;width:34px;height:34px;border:none;background:var(--surface);border-radius:var(--r8);cursor:pointer;font-size:18px;align-items:center;justify-content:center;color:var(--text);flex-shrink:0;transition:background .2s}
.hburg:hover{background:var(--n200)}
.tb-title h1{font-size:15px;font-weight:700;color:var(--text);white-space:nowrap}
.tb-title p{font-size:11px;color:var(--textm);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:400px}
.tb-right{display:flex;align-items:center;gap:6px;flex-shrink:0}

/* BTN */
.btn{display:inline-flex;align-items:center;gap:5px;padding:7px 13px;border:none;border-radius:var(--r8);font-family:inherit;font-size:12px;font-weight:600;cursor:pointer;transition:all .2s;white-space:nowrap;text-decoration:none}
.btn:active{transform:scale(.97)}
.btn-p{background:var(--g700);color:#fff}.btn-p:hover{background:var(--g600);box-shadow:0 4px 12px rgba(22,163,74,.3)}
.btn-a{background:var(--a500);color:#000}.btn-a:hover{background:var(--a400)}
.btn-o{background:transparent;color:var(--g700);border:1.5px solid var(--border)}.btn-o:hover{background:var(--g50);border-color:var(--g600)}
.btn-gh{background:var(--surface);color:var(--text2)}.btn-gh:hover{background:var(--n200)}
.btn-d{background:var(--r600);color:#fff}
.btn-i{background:var(--b600);color:#fff}
.btn-sm{padding:5px 10px;font-size:11px}
.btn-xs{padding:3px 7px;font-size:10.5px}
.btn-icon{width:30px;height:30px;padding:0;display:inline-flex;align-items:center;justify-content:center;border-radius:var(--r8)}

/* CURRENCY */
.cur-grp{display:flex;background:var(--surface);border-radius:var(--r8);padding:3px;border:1px solid var(--border)}
.cur-btn{padding:4px 9px;border:none;background:transparent;cursor:pointer;font-family:inherit;font-size:11.5px;font-weight:600;color:var(--textm);border-radius:var(--r4);transition:all .2s}
.cur-btn.active{background:var(--g700);color:#fff;box-shadow:var(--sh1)}

/* KPIS */
.kpi-bar{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--border);border-bottom:1px solid var(--border)}
.kpi{background:var(--card);padding:12px 16px;display:flex;align-items:center;gap:10px;transition:background .2s}
.kpi:hover{background:var(--g50)}
.kpi-ic{width:36px;height:36px;border-radius:var(--r8);display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0}
.ki-g{background:var(--g100)}.ki-a{background:var(--a100)}.ki-b{background:var(--b100)}.ki-r{background:var(--r100)}.ki-p{background:var(--p100)}
.kpi-info{min-width:0}
.kpi-lbl{font-size:10px;color:var(--textm);font-weight:500}
.kpi-val{font-size:16px;font-weight:700;color:var(--text);line-height:1.2;white-space:nowrap}
.kpi-sub{font-size:10px;color:var(--textf);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* CONTENT */
.content{padding:22px 26px;flex:1}
.sec{display:none}.sec.active{display:block}
.sec-intro{display:flex;align-items:flex-start;gap:12px;background:linear-gradient(135deg,var(--g50),#fff);border:1px solid var(--g100);border-radius:var(--r12);padding:13px 16px;margin-bottom:18px}
.sec-intro-ic{font-size:22px;flex-shrink:0;line-height:1}
.sec-intro h3{font-size:13.5px;font-weight:700;color:var(--g800);margin-bottom:2px}
.sec-intro p{font-size:12px;color:var(--textm);line-height:1.5}

/* CARD */
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--r16);margin-bottom:18px;box-shadow:var(--sh1);overflow:hidden}
.card-hd{display:flex;align-items:center;justify-content:space-between;padding:14px 20px 0;margin-bottom:14px}
.card-ti{display:flex;align-items:center;gap:7px;font-size:13.5px;font-weight:700;color:var(--text)}
.card-ti-ic{width:26px;height:26px;background:var(--g100);border-radius:var(--r4);display:flex;align-items:center;justify-content:center;font-size:13px}
.card-bd{padding:0 20px 18px}
.card-div{height:1px;background:var(--border);margin:14px 0}
.chip{display:inline-flex;align-items:center;gap:3px;background:var(--g100);color:var(--g800);font-size:10px;font-weight:700;padding:2px 7px;border-radius:20px}
.chip-a{background:var(--a100);color:#92400e}
.chip-b{background:var(--b100);color:#075985}
.chip-r{background:var(--r100);color:#991b1b}

/* GRIDS */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:13px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:13px}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:11px}
.g5{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}

/* FORM */
.fg{display:flex;flex-direction:column;gap:4px}
.fg label{font-size:11px;font-weight:600;color:var(--text2)}
.fg select,.fg input[type=number],.fg input[type=text]{
  padding:8px 10px;border:1.5px solid var(--border);border-radius:var(--r8);
  font-family:inherit;font-size:13px;color:var(--text);background:var(--surface);
  outline:none;transition:all .2s;width:100%
}
.fg select:focus,.fg input:focus{border-color:var(--g600);background:#fff;box-shadow:0 0 0 3px rgba(22,163,74,.1)}
.fg input.err{border-color:var(--r600);background:#fff5f5}
.fg .hint{font-size:10.5px;color:var(--textf)}
.fg .errmsg{font-size:10.5px;color:var(--r600);display:none}
.fg input.err~.errmsg{display:block}

/* ALERT */
.alert{display:flex;align-items:flex-start;gap:9px;padding:11px 14px;border-radius:var(--r8);font-size:12px;margin-bottom:14px}
.al-i{background:var(--b100);border:1px solid #7dd3fc;color:#0c4a6e}
.al-s{background:var(--g100);border:1px solid #86efac;color:var(--g800)}
.al-w{background:var(--a100);border:1px solid #fcd34d;color:#78350f}
.al-p{background:var(--p100);border:1px solid #c4b5fd;color:#4c1d95}

/* RANGE */
input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:5px;background:var(--border);border-radius:10px;outline:none}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:17px;height:17px;border-radius:50%;background:var(--g600);border:2px solid #fff;box-shadow:0 0 0 2px var(--g600);cursor:pointer}

/* OVERLAY */
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:250;backdrop-filter:blur(2px)}
.overlay.show{display:block}
.modal-wrap{display:none;position:fixed;inset:0;z-index:400;align-items:center;justify-content:center;padding:16px}
.modal-wrap.show{display:flex}
.modal{background:var(--card);border-radius:var(--r20);padding:24px;width:100%;max-width:520px;max-height:85vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.2);animation:mIn .2s ease}
@keyframes mIn{from{transform:scale(.95);opacity:0}to{transform:scale(1);opacity:1}}
.modal-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.modal-hd h2{font-size:16px;font-weight:700;color:var(--text)}
.modal-cls{width:28px;height:28px;border:none;background:var(--surface);border-radius:var(--r4);cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center;color:var(--textm)}
.proj-card{border:1px solid var(--border);border-radius:var(--r8);padding:12px 14px;margin-bottom:8px;cursor:pointer;transition:all .2s}
.proj-card:hover{border-color:var(--g500);background:var(--g50)}
.proj-name{font-weight:700;font-size:13.5px;color:var(--text)}
.proj-meta{font-size:11px;color:var(--textm);margin-top:3px}
.proj-acts{display:flex;gap:5px;margin-top:8px}

/* MATERIAL TABLE */
.mt{width:100%;border-collapse:collapse;font-size:12.5px}
.mt thead th{background:var(--surface);padding:8px 12px;text-align:left;font-size:10.5px;font-weight:700;color:var(--textm);text-transform:uppercase;letter-spacing:.05em;border-bottom:2px solid var(--border)}
.mt tbody tr{border-bottom:1px solid var(--n100)}
.mt tbody tr:hover{background:var(--g50)}
.mt td{padding:8px 12px}
.mt .ma{font-weight:700;color:var(--g700);text-align:right}
.mt .mq{color:var(--textm)}
.mt-tot td{background:linear-gradient(135deg,var(--g50),#fff)!important;font-weight:700;color:var(--g800);border-top:2px solid var(--g200)!important}

/* LABOR */
.labor-tbl{width:100%;border-collapse:collapse}
.labor-tbl thead th{background:var(--surface);padding:8px 10px;text-align:left;font-size:10px;font-weight:700;color:var(--textm);text-transform:uppercase;letter-spacing:.05em;border-bottom:2px solid var(--border)}
.labor-tbl tbody tr{border-bottom:1px solid var(--n100);transition:background .2s}
.labor-tbl tbody tr:hover{background:var(--g50)}
.labor-tbl td{padding:7px 8px;vertical-align:middle}
.labor-tbl input[type=number],.labor-tbl input[type=text]{
  width:100%;padding:5px 7px;border:1px solid var(--border);border-radius:var(--r4);
  font-family:inherit;font-size:12px;background:transparent;color:var(--text);transition:all .2s
}
.labor-tbl input:focus{border-color:var(--g600);background:#fff;outline:none;box-shadow:0 0 0 2px rgba(22,163,74,.1)}
.role-tag{display:inline-flex;align-items:center;padding:2px 7px;border-radius:20px;font-size:10px;font-weight:600;white-space:nowrap}
.rt-eng{background:#ede9fe;color:#4c1d95}
.rt-mas{background:#fef3c7;color:#92400e}
.rt-ski{background:var(--g100);color:var(--g800)}
.rt-sem{background:var(--b100);color:#075985}
.rt-hel{background:var(--n100);color:var(--n600)}
.labor-cost-cell{font-weight:700;color:var(--g700);text-align:right;font-size:12px;white-space:nowrap}
.del-btn{width:24px;height:24px;background:var(--r100);color:var(--r600);border:none;border-radius:var(--r4);cursor:pointer;font-size:12px;display:flex;align-items:center;justify-content:center;transition:all .2s}
.del-btn:hover{background:var(--r600);color:#fff}

/* TIMELINE */
.tl-track{height:16px;background:var(--n100);border-radius:8px;overflow:hidden;position:relative}
.tl-fill{height:100%;border-radius:8px;background:linear-gradient(90deg,var(--g700),var(--g500),var(--a500));transition:width .6s cubic-bezier(.4,0,.2,1);position:relative;overflow:hidden}
.tl-fill::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,255,255,.25),rgba(255,255,255,0));animation:shim 2s infinite}
@keyframes shim{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}
.tl-miles{display:grid;grid-template-columns:repeat(5,1fr);gap:0;margin-top:10px}
.tl-m{text-align:center;padding:8px 4px;position:relative}
.tl-m::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:2px;height:6px;background:var(--border)}
.tl-m-ic{font-size:16px}
.tl-m-nm{font-size:10px;font-weight:600;color:var(--textm);margin-top:2px}
.tl-m-t{font-size:13px;font-weight:700;color:var(--text)}
.tl-m-pct{font-size:10px;color:var(--g600);font-weight:600}

/* IMPACT CARDS */
.impact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}
.impact-c{background:var(--card);border:1px solid var(--border);border-radius:var(--r12);padding:14px;text-align:center;position:relative;overflow:hidden;box-shadow:var(--sh1)}
.impact-c::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px}
.ic-g::after{background:var(--g500)}.ic-a::after{background:var(--a500)}.ic-b::after{background:var(--b500)}.ic-p::after{background:var(--p600)}
.ic-lbl{font-size:10px;color:var(--textm);font-weight:500}
.ic-val{font-size:20px;font-weight:700;color:var(--text);line-height:1.2;margin:4px 0 2px}
.ic-chg{font-size:10px;padding:2px 6px;border-radius:10px}
.ch-up{background:var(--g100);color:var(--g700)}
.ch-dn{background:var(--r100);color:var(--r600)}
.ch-ne{background:var(--n100);color:var(--n500)}

/* QUICK LABOR BUTTONS */
.quick-btns{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:10px 0}
.qbtn{padding:6px 12px;border:1.5px solid var(--border);border-radius:20px;background:var(--surface);cursor:pointer;font-family:inherit;font-size:11.5px;font-weight:600;color:var(--text2);transition:all .2s}
.qbtn:hover{border-color:var(--g500);background:var(--g50);color:var(--g700)}
.qbtn.q-boost{border-color:var(--g400);color:var(--g700);background:var(--g50)}
.qbtn.q-reduce{border-color:var(--r600);color:var(--r600);background:var(--r100)}

/* FLOOR CUSTOM */
.floor-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.floor-card{border:1.5px solid var(--border);border-radius:var(--r12);overflow:hidden}
.floor-hd{background:var(--g800);color:#fff;padding:8px 14px;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:space-between}
.floor-bd{padding:12px 14px}
.floor-cost{font-size:13px;font-weight:700;color:var(--g700);text-align:center;padding:8px;background:var(--g50);border-radius:var(--r8);margin-top:8px}

/* FEATURE GRID */
.feat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}
.feat-item{border:1.5px solid var(--border);border-radius:var(--r8);padding:9px 10px;cursor:pointer;transition:all .2s;display:flex;flex-direction:column;gap:5px}
.feat-item:hover{border-color:var(--g500);background:var(--g50);transform:translateY(-1px);box-shadow:var(--sh1)}
.feat-item.sel{border-color:var(--g600);background:linear-gradient(135deg,var(--g50),#fff);box-shadow:0 0 0 2px rgba(22,163,74,.15)}
.feat-top{display:flex;align-items:flex-start;gap:6px}
.feat-chk{accent-color:var(--g600);width:13px;height:13px;flex-shrink:0;margin-top:1px;cursor:pointer}
.feat-nm{font-size:11.5px;font-weight:600;color:var(--text);line-height:1.3}
.feat-bot{display:flex;align-items:center;justify-content:space-between;gap:5px}
.feat-pr{font-size:10.5px;color:var(--textm)}
.feat-pr strong{color:var(--g700)}
.feat-qi{width:48px;padding:3px 5px;border:1px solid var(--border);border-radius:var(--r4);font-size:11px;font-family:inherit;background:#fff;color:var(--text)}
.feat-qi:focus{outline:none;border-color:var(--g500)}

/* EXTRAS TABS */
.sub-tabs{display:flex;gap:4px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r8);padding:4px;margin-bottom:16px;flex-wrap:wrap}
.sub-tab{padding:6px 13px;border:none;background:transparent;border-radius:var(--r4);cursor:pointer;font-family:inherit;font-size:12px;font-weight:500;color:var(--textm);transition:all .2s}
.sub-tab.active{background:var(--card);color:var(--g700);font-weight:700;box-shadow:var(--sh1)}
.etab{display:none}.etab.active{display:block}

/* FEES */
.fee-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--n100);font-size:13px}
.fee-row:last-child{border-bottom:none}
.fee-lbl{color:var(--text2)}
.fee-val{font-weight:700;color:var(--text)}
.fee-tot{padding-top:12px!important;border-top:2px solid var(--g200)!important;border-bottom:none!important}
.fee-tot .fee-lbl{font-weight:700;font-size:14px}
.fee-tot .fee-val{font-size:16px;color:var(--g700)}

/* BREAKDOWN */
.br-row{display:flex;justify-content:space-between;align-items:baseline;padding:8px 0;border-bottom:1px solid var(--n100);font-size:12.5px;gap:8px}
.br-row:last-child{border-bottom:none}
.br-lbl{color:var(--text2);flex:1}
.br-val{font-weight:600;color:var(--text);flex-shrink:0}
.br-tot{border-top:2px solid var(--g300)!important;border-bottom:none!important;padding-top:12px!important;margin-top:4px}
.br-tot .br-lbl{font-weight:700;font-size:15px}
.br-tot .br-val{font-size:18px;color:var(--g700);font-weight:800}

/* LOAN */
