const EX = { BDT:1, USD:0.0091, EUR:0.0083, INR:0.76, SAR:0.034 };
const SYM = { BDT:'৳', USD:'$', EUR:'€', INR:'₹', SAR:'﷼' };
let CUR = 'BDT';
function fmt(n){
  if(isNaN(n)||n<0) n=0;
  const v = n * EX[CUR];
  const s = SYM[CUR];
  if(CUR==='BDT') return s+' '+Math.round(v).toLocaleString('en-IN');
  return s+' '+v.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
}
function setCur(c,btn){
  CUR=c;
  document.querySelectorAll('.cur-btn').forEach(b=>b.classList.remove('active'));
  if(btn) btn.classList.add('active');
  calc();
}

// --- VALIDATION ---
function vp(el){
  const v=parseFloat(el.value);
  if(isNaN(v)||v<0){el.value=0;el.classList.add('err');setTimeout(()=>el.classList.remove('err'),1500);}
  else el.classList.remove('err');
}
function g(id){return document.getElementById(id);}
