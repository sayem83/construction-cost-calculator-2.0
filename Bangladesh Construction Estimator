function getTabTitle(tab) {
  const m = { basic:'🏠 বেসিক সুবিধা', smart:'🤖 স্মার্ট হোম', green:'🌿 গ্রীন বিল্ডিং', sec:'🔒 নিরাপত্তা', util:'🔧 ইউটিলিটি', outdoor:'🌳 আউটডোর', luxury:'👑 বিলাসবহুল' };
  return m[tab] || tab;
}

function showET(tab, btn) {
  document.querySelectorAll('.etab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.sub-tab').forEach(b => b.classList.remove('active'));
  const el = g('et-' + tab);
  if (el) el.classList.add('active');
  if (btn) btn.classList.add('active');
}

function getExtrasCost() {
  let total = 0;
  const sqft = Math.max(0, +(g('area')?.value || 0));
  Object.values(EXTRAS_DATA).flat().forEach(item => {
    const el = g('ex-' + item.id);
    if (!el) return;
    const v = parseFloat(el.value) || 0;
    if (item.isSqft) total += v * sqft;
    else total += v;
  });
  return total;
}

