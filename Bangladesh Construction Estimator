  while (FLOORS_DATA.length < floors + basement) {
    const idx = FLOORS_DATA.length;
    FLOORS_DATA.push({ finish: 'standard', tile: 'ceramic', ceil: 'gyp', ac: false, marble: false, extra: 0, isBasement: idx < basement });
