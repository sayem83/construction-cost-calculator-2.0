// --- EMI CALCULATOR (Real logic) ---
function calcLoan() {
  const P = Math.max(0, +(g('loan-amt')?.value || 0));
  const annualRate = Math.max(0, +(g('loan-rate')?.value || 9));
  const years = Math.max(1, +(g('loan-yrs')?.value || 15));
  const type = g('loan-type')?.value || 'reducing';
  const n = years * 12;

  if (P === 0) { s('emi-val', '৳ ০'); s('loan-meta', '—'); return; }

  let emi, totalPay, totalInt;

  if (type === 'flat') {
    // Flat rate: interest = P × r × years, EMI = (P + interest) / n
    totalInt = P * (annualRate / 100) * years;
    totalPay = P + totalInt;
    emi = totalPay / n;
  } else if (type === 'islamic') {
    // Murabaha: fixed profit, similar to flat but called profit
    const profitRate = annualRate * 0.9; // slightly less
    totalInt = P * (profitRate / 100) * years;
    totalPay = P + totalInt;
    emi = totalPay / n;
  } else {
    // Reducing balance (standard EMI formula)
    const r = annualRate / 100 / 12;
    if (r === 0) { emi = P / n; totalPay = P; totalInt = 0; }
    else {
      emi = P * r * Math.pow(1 + r, n) / (Math.pow(1 + r, n) - 1);
      totalPay = emi * n;
      totalInt = totalPay - P;
    }
  }

  s('emi-val', '৳ ' + Math.round(emi).toLocaleString());
  s('loan-meta',
    `মোট পরিশোধ: ৳${Math.round(totalPay).toLocaleString()} | মোট সুদ/মুনাফা: ৳${Math.round(totalInt).toLocaleString()}\n` +
    `প্রতি বছর: ৳${Math.round(emi * 12).toLocaleString()} | মোট বছর: ${years}`
  );
}

